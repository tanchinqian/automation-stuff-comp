{
  "name": "pastetrace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PasteTrace - an integrated troubleshooting console that turns a board inspection image into an explainable root-cause diagnosis, a step-by-step fix plan, and an exportable 8D report, learning from every case it closes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "esbuild engine.test.ts --bundle --platform=node --format=esm --outfile=.test.mjs --log-level=error --external:@huggingface/transformers --external:onnxruntime-web && node .test.mjs",
    "eval": "esbuild eval/runEval.ts --bundle --platform=node --format=esm --outfile=eval/.eval.mjs --log-level=error --external:@huggingface/transformers --external:onnxruntime-web && node eval/.eval.mjs",
    "boards:placeholder": "node scripts/generate-placeholder-boards.mjs",
    "boards:real": "node scripts/build-boards.mjs",
    "yolo:prep": "python scripts/yolo_prep.py",
    "yolo:train": "python scripts/train_yolo.py",
    "yolo:export": "python scripts/export_yolo.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "esbuild": "^0.25.12",
    "htmlparser2": "^12.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
